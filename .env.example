SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional but strongly recommended — the chain's free default RPC
# (sepolia.base.org) is shared and rate-limited, and has repeatedly caused
# 503s, slow reads, and even rejected transactions ("exceeds max gas
# limit") under real usage. Get a free dedicated endpoint from Alchemy or
# Infura for Base Sepolia (and Base, for mainnet) and set these — the app
# automatically falls back to the default RPC if left unset.
VITE_BASE_SEPOLIA_RPC_URL=
VITE_BASE_RPC_URL=

# Server-only — never expose this to the client. Supabase dashboard →
# Settings → API → the "service_role" secret key.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
